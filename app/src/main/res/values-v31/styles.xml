<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- PulsePlay: Android 12+ draws the start screen itself: the round logo pops in with its
         bars and cyan rings on the app's dark background; StartupSplash keeps it while the Home
         reads its videos (short) and then opens the Home with a zoom -->
    <style name="OpeningTheme" parent="Base.OpeningTheme">
        <item name="android:windowSplashScreenBackground">#0F0E13</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/pulseplay_splash_animated</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
</resources>
