<?xml version="1.0" encoding="utf-8"?>
<!-- PulsePlay: see pulseplay_backup_rules.xml (Android 12+ reads this one) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pulseplay_sync.xml" />
        <exclude domain="file" path="pulseplay_sync/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pulseplay_sync.xml" />
        <exclude domain="file" path="pulseplay_sync/" />
    </device-transfer>
</data-extraction-rules>
