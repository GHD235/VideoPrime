<?xml version="1.0" encoding="utf-8"?>
<!-- PulsePlay: the logo of the start screen (Android 12+). The system shows the middle 2/3 of
     this drawing inside a circle (radius 36 of 108), so the logo is drawn smaller and the cyan
     rings grow up to that edge. The logo pops in, the bars rise one after another and then keep
     moving gently with the rings while the app loads. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="ring1"
                android:pivotX="54"
                android:pivotY="54">
                <path
                    android:name="ring1path"
                    android:pathData="M54,32 a22,22 0 1,1 0,44 a22,22 0 1,1 0,-44"
                    android:strokeAlpha="0"
                    android:strokeColor="#22D3EE"
                    android:strokeWidth="1.6" />
            </group>
            <group
                android:name="ring2"
                android:pivotX="54"
                android:pivotY="54">
                <path
                    android:name="ring2path"
                    android:pathData="M54,32 a22,22 0 1,1 0,44 a22,22 0 1,1 0,-44"
                    android:strokeAlpha="0"
                    android:strokeColor="#22D3EE"
                    android:strokeWidth="1.6" />
            </group>
            <group
                android:name="logo"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.3"
                android:scaleY="0.3">
                <path android:pathData="M54,32 a22,22 0 1,1 0,44 a22,22 0 1,1 0,-44">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:endColor="#A21CAF"
                            android:endX="70"
                            android:endY="70"
                            android:startColor="#4F46E5"
                            android:startX="38"
                            android:startY="38"
                            android:type="linear" />
                    </aapt:attr>
                </path>
                <group
                    android:scaleX="0.36"
                    android:scaleY="0.36"
                    android:translateX="34"
                    android:translateY="36">
                    <path
                        android:fillColor="#FFFFFF"
                        android:pathData="M24.00,29.00 L24.00,75.00 Q24.00,84.00 31.81,79.53 L72.19,56.47 Q80.00,52.00 72.19,47.53 L31.81,24.47 Q24.00,20.00 24.00,29.00 Z" />
                    <path
                        android:name="bar1"
                        android:pathData="M68.5,21 V21"
                        android:strokeColor="#22D3EE"
                        android:strokeLineCap="round"
                        android:strokeWidth="0" />
                    <path
                        android:name="bar2"
                        android:pathData="M77,21 V21"
                        android:strokeColor="#22D3EE"
                        android:strokeLineCap="round"
                        android:strokeWidth="0" />
                    <path
                        android:name="bar3"
                        android:pathData="M85.5,21 V21"
                        android:strokeColor="#22D3EE"
                        android:strokeLineCap="round"
                        android:strokeWidth="0" />
                </group>
            </group>
        </vector>
    </aapt:attr>
    <!-- the logo pops in (a small overshoot, then its size) -->
    <target android:name="logo">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="380"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleX"
                    android:valueFrom="0.3"
                    android:valueTo="1" />
                <objectAnimator
                    android:duration="380"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleY"
                    android:valueFrom="0.3"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>
    <!-- the bars rise one after another, then move gently while the app loads -->
    <target android:name="bar1">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <set>
                <objectAnimator
                    android:duration="1"
                    android:propertyName="strokeWidth"
                    android:startOffset="200"
                    android:valueFrom="0"
                    android:valueTo="6"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="240"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="pathData"
                    android:startOffset="200"
                    android:valueFrom="M68.5,21 V21"
                    android:valueTo="M68.5,16 V26"
                    android:valueType="pathType" />
                </set>
                <objectAnimator
                    android:duration="420"
                    android:propertyName="pathData"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:valueFrom="M68.5,16 V26"
                    android:valueTo="M68.5,12 V30"
                    android:valueType="pathType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="bar2">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <set>
                <objectAnimator
                    android:duration="1"
                    android:propertyName="strokeWidth"
                    android:startOffset="280"
                    android:valueFrom="0"
                    android:valueTo="6"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="240"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="pathData"
                    android:startOffset="280"
                    android:valueFrom="M77,21 V21"
                    android:valueTo="M77,9 V33"
                    android:valueType="pathType" />
                </set>
                <objectAnimator
                    android:duration="420"
                    android:propertyName="pathData"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:valueFrom="M77,9 V33"
                    android:valueTo="M77,15 V27"
                    android:valueType="pathType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="bar3">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <set>
                <objectAnimator
                    android:duration="1"
                    android:propertyName="strokeWidth"
                    android:startOffset="360"
                    android:valueFrom="0"
                    android:valueTo="6"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="240"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="pathData"
                    android:startOffset="360"
                    android:valueFrom="M85.5,21 V21"
                    android:valueTo="M85.5,14 V28"
                    android:valueType="pathType" />
                </set>
                <objectAnimator
                    android:duration="420"
                    android:propertyName="pathData"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:valueFrom="M85.5,14 V28"
                    android:valueTo="M85.5,9 V33"
                    android:valueType="pathType" />
            </set>
        </aapt:attr>
    </target>
    <!-- ring 1: grows from the logo to the edge of the circle and fades, like sound -->
    <target android:name="ring1">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="900"
                    android:interpolator="@android:anim/decelerate_interpolator"
                    android:propertyName="scaleX"
                    android:repeatCount="infinite"
                    android:startOffset="350"
                    android:valueFrom="1"
                    android:valueTo="1.6" />
                <objectAnimator
                    android:duration="900"
                    android:interpolator="@android:anim/decelerate_interpolator"
                    android:propertyName="scaleY"
                    android:repeatCount="infinite"
                    android:startOffset="350"
                    android:valueFrom="1"
                    android:valueTo="1.6" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="ring1path">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="900"
                android:propertyName="strokeAlpha"
                android:repeatCount="infinite"
                android:startOffset="350"
                android:valueFrom="0.9"
                android:valueTo="0" />
        </aapt:attr>
    </target>
    <!-- ring 2: grows from the logo to the edge of the circle and fades, like sound -->
    <target android:name="ring2">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="900"
                    android:interpolator="@android:anim/decelerate_interpolator"
                    android:propertyName="scaleX"
                    android:repeatCount="infinite"
                    android:startOffset="800"
                    android:valueFrom="1"
                    android:valueTo="1.6" />
                <objectAnimator
                    android:duration="900"
                    android:interpolator="@android:anim/decelerate_interpolator"
                    android:propertyName="scaleY"
                    android:repeatCount="infinite"
                    android:startOffset="800"
                    android:valueFrom="1"
                    android:valueTo="1.6" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="ring2path">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="900"
                android:propertyName="strokeAlpha"
                android:repeatCount="infinite"
                android:startOffset="800"
                android:valueFrom="0.9"
                android:valueTo="0" />
        </aapt:attr>
    </target>
</animated-vector>
