<?xml version="1.0" encoding="utf-8"?>
<!-- PulsePlay: a TV (it never turns, so the two panes are always there): sections on the left, the options of the
     chosen one in the middle and, on the right, what the option under the focus does -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="org.schabi.newpipe.MainActivity">

    <include
        android:id="@+id/settings_toolbar_layout"
        layout="@layout/toolbar_layout" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/settings_sections_holder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="30" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/settings_fragment_holder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="44" />

        <LinearLayout
            android:id="@+id/settings_help_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="26"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="28dp">

            <TextView
                android:id="@+id/settings_help_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settings_help_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.25"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
