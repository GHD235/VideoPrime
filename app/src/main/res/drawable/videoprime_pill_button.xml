<?xml version="1.0" encoding="utf-8"?>
<!-- VideoPrime: a rounded secondary button -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#337C3AED">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#1F7C3AED" />
            <stroke
                android:width="1dp"
                android:color="#407C3AED" />
        </shape>
    </item>
</ripple>
