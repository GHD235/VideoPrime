<?xml version="1.0" encoding="utf-8"?>
<!-- VideoPrime: round button of the video page, like the buttons of the video menu -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="56dp" android:height="56dp">
        <shape android:shape="oval">
            <solid android:color="@color/videoprime_detail_circle_fill" />
            <stroke android:width="1dp" android:color="@color/videoprime_detail_circle_stroke" />
        </shape>
    </item>
    <item android:width="24dp" android:height="24dp" android:gravity="center"
        android:drawable="@drawable/ic_file_download" />
</layer-list>
