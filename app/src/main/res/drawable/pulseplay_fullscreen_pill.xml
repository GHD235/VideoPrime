<?xml version="1.0" encoding="utf-8"?>
<!-- PulsePlay: "Full screen" on the video page (TV mock-up B): a dark pill, white ring with the
     remote's focus -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#FF2D2A38" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#FF3A3648" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#FF24212E" />
        </shape>
    </item>
</selector>
