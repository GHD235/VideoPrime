<?xml version="1.0" encoding="utf-8"?>
<!-- VideoPrime: "Library" section of the bottom navigation -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/library_history"
            style="@style/VideoPrime.LibraryTile"
            android:layout_marginEnd="6dp"
            android:text="@string/action_history"
            app:drawableTopCompat="@drawable/ic_history" />

        <TextView
            android:id="@+id/library_downloads"
            style="@style/VideoPrime.LibraryTile"
            android:layout_marginStart="6dp"
            android:text="@string/downloads"
            app:drawableTopCompat="@drawable/ic_file_download" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/library_queues"
            style="@style/VideoPrime.LibraryTile"
            android:layout_marginEnd="6dp"
            android:text="@string/queues_title"
            app:drawableTopCompat="@drawable/ic_playlist_play" />

        <TextView
            android:id="@+id/library_settings"
            style="@style/VideoPrime.LibraryTile"
            android:layout_marginStart="6dp"
            android:text="@string/settings"
            app:drawableTopCompat="@drawable/ic_settings" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/library_about"
            style="@style/VideoPrime.LibraryTile"
            android:layout_marginEnd="6dp"
            android:text="@string/library_about"
            app:drawableTopCompat="@drawable/ic_info_outline" />

        <TextView
            android:id="@+id/library_offline"
            style="@style/VideoPrime.LibraryTile"
            android:layout_marginStart="6dp"
            android:text="@string/offline_title"
            app:drawableTopCompat="@drawable/ic_cloud_download" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingHorizontal="16dp"
        android:text="@string/library_playlists"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textStyle="bold"
        android:accessibilityHeading="true"
        tools:targetApi="p" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/library_bookmarks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
