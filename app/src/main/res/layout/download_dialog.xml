<?xml version="1.0" encoding="utf-8"?>
<!-- VideoPrime: a sheet from the bottom: video / audio / subtitles as chips, rounded fields and a
     big "Download" button (the old toolbar stays hidden, the threads are set in the settings) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/videoprime_sheet_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <include
        android:id="@+id/toolbar_layout"
        layout="@layout/toolbar_layout"
        android:visibility="gone" />

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/videoprime_sheet_handle" />

    <org.schabi.newpipe.views.NewPipeTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="12dp"
        android:text="@string/download_dialog_title"
        android:textSize="19sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/video_audio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/video_button"
            style="@style/VideoPrimeRadioChip"
            android:checked="true"
            android:text="@string/video" />

        <RadioButton
            android:id="@+id/audio_button"
            style="@style/VideoPrimeRadioChip"
            android:text="@string/audio" />

        <RadioButton
            android:id="@+id/subtitle_button"
            style="@style/VideoPrimeRadioChip"
            android:text="@string/caption_setting_title" />
    </RadioGroup>

    <Spinner
        android:id="@+id/quality_spinner"
        style="@style/VideoPrimeSpinner"
        tools:listitem="@layout/stream_quality_item" />

    <Spinner
        android:id="@+id/audio_track_spinner"
        style="@style/VideoPrimeSpinner"
        tools:visibility="gone" />

    <Spinner
        android:id="@+id/audio_stream_spinner"
        style="@style/VideoPrimeSpinner"
        tools:visibility="gone" />

    <org.schabi.newpipe.views.NewPipeTextView
        android:id="@+id/audio_track_present_in_video_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:text="@string/audio_track_present_in_video"
        android:textSize="12sp" />

    <org.schabi.newpipe.views.NewPipeTextView
        android:id="@+id/file_name_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="6dp"
        android:text="@string/msg_name"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <org.schabi.newpipe.views.NewPipeEditText
        android:id="@+id/file_name"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/videoprime_field_background"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <org.schabi.newpipe.views.NewPipeTextView
        android:id="@+id/threads_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/msg_threads"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/threads_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/threads_count"
            android:layout_width="25dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            tools:text="3" />

        <SeekBar
            android:id="@+id/threads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="31"
            android:progress="3" />
    </LinearLayout>

    <Button
        android:id="@+id/videoprime_download_button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/videoprime_main_button"
        android:enabled="false"
        android:stateListAnimator="@null"
        android:text="@string/download"
        android:textAllCaps="false"
        android:textColor="@color/videoprime_main_button_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <org.schabi.newpipe.views.NewPipeTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/streams_not_yet_supported_removed"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="11sp" />

</LinearLayout>
